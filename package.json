{
  "name": "hono-node-starter",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": ".output/main.js",
  "scripts": {
    "load-env": "dotenv -e .env.local --",
    "dev": "dotenv -e .env.local -- tsx watch --clear-screen=false --import ./src/tracing.ts ./src/main.ts",
    "start:prod": "node --import ./.output/tracing.js .output/main.js",
    "start": "dotenv -e .env.local -- node --import ./.output/tracing.js .output/main.js",
    "build": "tsup",
    "check": "tsc --noEmit",
    "fmt": "npx biome format . --write && npx biome check . --write",
    "db:generate": "npm run load-env drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "npm run load-env drizzle-kit push --config=drizzle.config.ts",
    "db:check": "npm run load-env drizzle-kit check --config=drizzle.config.ts",
    "db:clean": "npm run load-env tsx src/database/dbClean.ts",
    "db:up": "npm run load-env drizzle-kit up --config=drizzle.config.ts",
    "db:drop": "npm run load-env drizzle-kit drop --config=drizzle.config.ts",
    "db:studio": "npm run load-env drizzle-kit studio --port 3333  --config=drizzle.config.ts",
    "db:migrate": "npm run load-env tsx src/database/migrate.ts",
    "ts:check": "tsc --noEmit",
    "new:v1apiPublic": "hypergen new v1api",
    "new:v1api": "hypergen new v1apiWithAuth"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono-storage/core": "^0.0.14",
    "@hono-storage/node-disk": "^0.0.17",
    "@hono/node-server": "^2.0.6",
    "@hono/zod-openapi": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-undici": "^0.29.0",
    "@opentelemetry/instrumentation-winston": "^0.63.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/winston-transport": "^0.29.0",
    "@scalar/hono-api-reference": "^0.11.4",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.14d",
    "canvas": "^3.2.3",
    "chalk": "^5.4.1",
    "change-case": "^5.4.4",
    "cli-highlight": "^2.1.11",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.0.0",
    "hono": "^4.12.26",
    "ioredis": "^5.5.0",
    "itty-time": "^2.0.2",
