    "pg-error-enum": "^2.0.1",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.0",
    "typeid-js": "^1.2.0",
    "ua-parser-js": "^2.0.10",
    "unstorage": "^1.14.4",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.0",
    "@types/ua-parser-js": "^0.7.39",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "enquirer": "^2.4.1",
    "firebase": "^12.15.0",
    "fs-extra": "^11.3.0",
    "hypergen": "^8.0.0-beta.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
